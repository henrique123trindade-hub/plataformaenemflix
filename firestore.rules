rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /videoProgress/{progressId} {
      allow read, write: if request.auth != null && resource == null || (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }
    match /simulatedExams/{examId} {
      allow read, write: if request.auth != null && resource == null || (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }
    match /essays/{essayId} {
      allow read, write: if request.auth != null && resource == null || (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }
    match /aiConversations/{conversationId} {
      allow read, write: if request.auth != null && resource == null || (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }
  }
}
